# Copy this file to .env and fill in the key. .env is gitignored.
#
# On/off settings accept 1/0, true/false, yes/no, on/off. Anything else keeps
# the default and says so at startup — a typo used to switch a feature off in
# silence (TTS_ENABLED=1heo is not "1", so speech turned itself off and the only
# symptom was a bot that logged "speaking at 8297ms" and made no sound).

OPENAI_API_KEY=sk-...

# Model ids. These default to the names in docs/components.md.
# If the API rejects one, run `python -m demo.check_setup` — it prints what
# your key can actually see — then override it here.
VISION_MODEL=gpt-5.6-luna
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Transcription via Groq (free tier). Measured at roughly half the latency for
# the same text — 554ms against 1119ms on 20-26s of speech, identical English
# output, Japanese 0.98 on both. Transcription is ~40% of a press, so this is
# the largest saving left.
# The OpenAI model above stays as the fallback and is used automatically if Groq
# fails, so a rate limit mid-meeting never costs an answer. Blank = OpenAI only.
# Get a key at console.groq.com.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Reasons over transcript + screen state. Defaults to VISION_MODEL.
ANSWER_MODEL=

# Spoken output. On by default.
TTS_ENABLED=1

# Where answers appear on screen:
#   history - ONE window, opened at startup, with the running log of what was
#             heard and what was answered. Scrollable. F7 hides/shows it.
#   read    - a card, only when the answer carries something to LOOK at.
#   always  - a card on every answer.
#   off     - nothing; voice only.
# Read from this window rather than the terminal: it is excluded from screen
# capture, and VS Code / Windows Terminal cannot be.
OVERLAY_MODE=history

# The background screen loop. OFF by default. F10 grabs a fresh screenshot at
# press time, which is newer than anything a poll could cache and reads detail no
# summary keeps — so the loop only added a vision call every few seconds. On a
# video call it is actively wasteful: the frame diff fires on every head movement
# and it re-describes a webcam over and over. Set to 1 only if you want the
# no-model-call fallback answer back.
SCREEN_LOOP_ENABLED=0

# Playback speed, 0.25-4.0. Default voices read at a presenter's pace, which is
# too slow mid-meeting — by the time the answer finishes you have missed what
# was said next. 1.75 is brisk but still clear on one listen, which is all you
# get. Drop it if answers in your second or third language start slipping past.
TTS_SPEED=1.75

# Speak with Windows' own voices when one matches the answer's language.
# Measured 56-75ms for a whole clip against ~1800ms to the API's FIRST byte,
# which is the single largest saving available — it roughly halves the wait
# before you hear anything.
# Needs pywin32 and an installed voice for that language. Anything missing
# (no pywin32, no voice, synthesis error) falls back to the API automatically,
# so this is safe to leave on across machines. Set to 0 to always use the API.
LOCAL_TTS=1

# Substring match against your output device name, e.g. "Earbuds" or "WH-1000".
# Blank uses the system default, which is fine for a solo test with a YouTube
# video but NOT for a real meeting — pin it to your earphones so spoken answers
# can never reach the meeting mic. `python -m demo.check_setup` lists the names.
TTS_DEVICE=

# Buttons. The F-keys are contested — screenshot tools bind F10, browsers take
# F12, OEM laptops send media keys unless Fn is held. If a button does nothing,
# or does something else entirely, another app owns that key: run
# `python -m demo.check_setup --keys` to see what actually arrives, then pick a
# key nothing else wants. Single keys only (pynput names, brackets optional).
# Rarely contested: pause, scroll_lock, insert, f13-f24.
HOTKEY_AUDIO=<f9>
HOTKEY_FULL=<f10>
# F11 — the same question as F9, answered in depth. One spoken sentence, then
# the detail printed below the --- marker to be read: 150 words at 1.75x is
# half a minute of talking over a live meeting.
HOTKEY_DETAIL=<f11>
# F8 — the whole meeting so far, in points. One spoken line, bullets below.
HOTKEY_SUMMARY=<f8>
# F4 — type a standing request into the history window: "translate instead of
# answering", "just give me the number". Enter applies it to every press, Escape
# clears it, empty is normal behaviour.
HOTKEY_ASK=<f4>
HOTKEY_HISTORY=<f7>
HOTKEY_QUIT=<f12>

# --- Listening to the meeting ---
AUDIO_ENABLED=1

# Substring match against an INPUT device name. This must be a LOOPBACK device —
# one that captures the system output mix — or the bot hears you instead of the
# people talking to you. On Realtek hardware that is "Stereo Mix", which Windows
# ships DISABLED: Win+R -> mmsys.cpl -> Recording -> right-click -> Show Disabled
# Devices -> enable Stereo Mix. `check_setup` plays a test tone and tells you
# whether the device actually hears anything, which name-matching alone cannot.
# If Stereo Mix stays dead, install VB-Audio Cable and use CABLE Output.
# How to hear the other people in the call:
#   auto      WASAPI loopback of your default speaker if available, else
#             AUDIO_DEVICE below. This is the default and what you want.
#   loopback  force WASAPI loopback
#   device    force AUDIO_DEVICE (Stereo Mix)
#
# WASAPI loopback attaches to the OUTPUT DEVICE, so it follows whatever you are
# listening on — Bluetooth headphones included. Stereo Mix is a capture pin on
# the onboard codec: route audio to a Bluetooth headset and it records silence
# while the meeting plays perfectly. It also avoids Stereo Mix being disabled by
# default, enumerated-but-dead, or locked by a crashed process.
LOOPBACK_MODE=auto

# Only used when LOOPBACK_MODE falls back to a named device.
AUDIO_DEVICE=Stereo Mix

# Your own microphone, captured alongside the loopback and merged into the same
# transcript tagged "You". Without it the bot hears the meeting talk *at* you but
# never hears you answer. Blank = system default recording device.
MIC_ENABLED=1
MIC_DEVICE=

# Keep this tool's own windows out of screen shares — the overlay, and the
# console the answers print into. Windows' WDA_EXCLUDEFROMCAPTURE: normal on
# your monitor, absent from any capture. Verify with `check_setup --hide`.
# Hides WINDOWS only — spoken answers still reach the call if TTS_DEVICE points
# at your speakers.
HIDE_FROM_CAPTURE=1

# How often the background sweep transcribes what has been captured. This is the
# main speed/accuracy trade, and it is worth testing on your own meetings rather
# than trusting the benchmark: the 0.844-vs-0.992 accuracy figures came from
# synthetic TTS speech, which is cleaner and more evenly paced than a real
# compressed call.
#   7   press is fastest (almost nothing left to transcribe), most boundaries
#   20  default
#   0   never sweep; every press transcribes everything since the last one
# Watch "avg clip" in the quit report, and compare transcripts in the history
# window between runs.
BACKGROUND_TRANSCRIBE_SECONDS=20
# Cap on how much audio one press can transcribe.
AUDIO_BUFFER_MAX_SECONDS=45

# --- Reference documents ---
# Drop .txt or .md files into demo/data/docs (job spec, architecture notes,
# glossary, agenda) and their FULL text goes with every answer. No retrieval, no
# index: re-read on each press, so editing a file or adding one is live on the
# next press with no restart. Other formats are named in the log and skipped.
# The folder is gitignored.
DOCS_ENABLED=1
# A warning, not a limit. Everything here rides on every answer, so past this
# the folder is big enough that sending it whole is the wrong design.
DOCS_MAX_CHARS=20000

# --- Illustrations (F11) ---
# Some questions have a shape for an answer — "can you draw a simple load
# balancer architecture". F11 decides on its own when a drawing is what was
# asked for, generates one with gpt-image-2, and shows it in the history window
# (the only surface excluded from screen capture).
# ALWAYS ASYNCHRONOUS: ~20-40s to draw, so the spoken cue and the written answer
# arrive at their normal speed and the picture follows. Failures are one log
# line and never cost you the answer. Set to 0 to turn drawing off.
IMAGE_ENABLED=1
IMAGE_MODEL=gpt-image-2
# 1536x1024 landscape suits architecture sketches. Also 1024x1024, 1024x1536.
IMAGE_SIZE=1536x1024
# Per IMAGE, not per token — check your billing page.
RATE_IMAGE_EACH=0.04

# --- Live transcription (optional) ---
# batch  = accumulate audio, transcribe a clip per press/sweep. The default.
# stream = hold a websocket open, receive the transcript as it is spoken.
# Streaming does not hallucinate on silence, scores 0.91/0.87 against 0.77/0.77,
# and has the transcript ready ~700ms after speech ends rather than 1-3s after
# the press. It costs ~20x more ($0.017/min vs $0.003/min, billed on wall-clock
# time) — roughly $1/hour per source. Set back to batch to undo it entirely.
TRANSCRIBE_MODE=batch
STREAM_MODEL=gpt-live-transcribe
# Stop sending after this long without speech, purely to avoid paying for an
# empty room. The socket stays open, so speech resumes instantly.
STREAM_IDLE_PAUSE=2.0

# --- Cost estimate, printed on quit ---
# USAGE is measured from what the API reports. These RATES are a guess and go
# stale, so check them against your billing page — otherwise read the total as
# an order of magnitude, not a bill.
RATE_TRANSCRIBE_PER_MIN=0.003
RATE_ANSWER_IN_PER_M=2.50
RATE_ANSWER_OUT_PER_M=10.00
RATE_TTS_PER_M_CHARS=15.00

# --- Meeting minutes, written when you quit ---
# Two files land in demo/data/minutes (gitignored): the raw transcript, and
# minutes generated from it. The transcript is saved FIRST and unconditionally,
# so a failed model call at quit never costs you the record of the meeting.
# The answer buttons read a rolling 15-minute window to keep prompts small;
# minutes are written from an unpruned archive of the whole session.
MINUTES_ENABLED=1
# Decisions land late, so the TAIL is kept if a meeting runs longer than this.
MINUTES_MAX_CHARS=60000
